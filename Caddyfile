# Canonical host: www.altovisas.com
#
# Google has indexed both hostnames, which splits link equity between them and
# lets the same page compete with itself. The apex now issues a permanent
# redirect to www rather than serving a duplicate copy, and every page carries a
# self-referencing canonical pointing at www (generated by the frontend's SEO
# build step - see frontend/src/seo/site.js).
#
# www rather than apex because www is already the majority-indexed host here and
# the existing Open Graph tags point at it. Apex is shorter, which is its only
# real advantage; it is not worth re-pointing a live index for.
altovisas.com {
    redir https://www.altovisas.com{uri} permanent
}

www.altovisas.com {
    # Caddy handles .well-known/acme-challenge for Let's Encrypt automatically,
    # ahead of this directive.
    reverse_proxy altoai-mvp:8080 {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
    }
}
