# ---- Go ----
bin/
*.exe
*.log
*.out
*.test
coverage.out

# build cache
go-build/
*.exe~
*.dll
*.so
*.dylib

# ---- Environment ----
.env
*.env
.env.*

# ---- Node / Frontend ----
frontend/node_modules/
frontend/dist/
# The Go production binary embeds the built Vite application. Keep the
# production bundle versioned so Vercel's Go-only builder can compile it.
!frontend/dist/
!frontend/dist/**
frontend/.env
frontend/.DS_Store
frontend/.vite/
frontend/.parcel-cache/
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# ---- macOS / VSCode ----
.DS_Store
.vscode/
.idea/
*.swp

# ---- visa-llm (Python service) ----
visa-llm/.venv/
visa-llm/__pycache__/
visa-llm/**/__pycache__/
visa-llm/*.egg-info/
visa-llm/.pytest_cache/
