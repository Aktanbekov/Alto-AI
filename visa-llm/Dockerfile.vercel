FROM python:3.12-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY src ./src
# Vercel's service containers are CPU-only. Installing torch from PyPI pulls
# the Linux CUDA runtime as well, adding several gigabytes of unused packages.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir ".[rag,web]"

COPY data ./data
COPY web ./web
COPY examples ./examples

# Vercel assigns a dynamic port. The fallback keeps the image runnable outside
# Vercel as well.
CMD ["sh", "-c", "visa-llm serve --host 0.0.0.0 --port ${PORT:-8000}"]
