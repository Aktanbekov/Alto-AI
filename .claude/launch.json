{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "go",
      "runtimeArgs": ["run", "cmd/api/main.go"],
      "port": 8080
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "visa-llm",
      "runtimeExecutable": "visa-llm/.venv/bin/visa-llm",
      "runtimeArgs": ["serve", "--port", "8099"],
      "port": 8099
    }
  ]
}
